# ============================================================
# MedGemma GPU API — sozlamalar
# `.env` faylini shu namunadan yarating: cp .env.example .env
# ============================================================

# --- XAVFSIZLIK (majburiy) ---------------------------------
# API kaliti. Busiz servis HAR QANDAY so'rovni rad etadi (503).
# Yaratish:  openssl rand -hex 32
MG_API_KEY=

# Kalitni almashtirayotganda eskisini vaqtincha qoldirish uchun
# vergul bilan bir nechta kalit berish mumkin:
# MG_API_KEYS=yangi_kalit,eski_kalit

# Faqat AviRadiolog backend murojaat qiladi, brauzer emas.
# Shuning uchun CORS kerak emas va ochilmaydi.

# --- Model -------------------------------------------------
MG_ENGINE=transformers
MG_MODEL=google/medgemma-1.5-4b-it
# `google/*` repolari GATED — HuggingFace tokeni kerak:
#   https://huggingface.co/google/medgemma-1.5-4b-it (Access repository)
HF_TOKEN=

# Bir so'rovda modelga yuboriladigan maksimal rasm
MG_MAX_IMAGES=8
MG_MAX_NEW_TOKENS=1200
MG_TEMPERATURE=0.0
MG_INFER_PX=1024

# --- PHI xavfsizligi ---------------------------------------
# Tarmoq engine'larini (OpenAI/Vertex) butunlay bloklaydi.
# Bemor ma'lumoti bilan ishlaganda 1 BO'LISHI SHART.
MG_LOCAL_ONLY=1

# Yuklangan DICOM arxivlari shu soatdan keyin avtomatik o'chiriladi.
# Ijaradagi mashinada PHI uzoq turmasligi kerak. 0 = o'chirmaslik.
MG_RETENTION_HOURS=24

# --- Chegaralar (ochiq endpoint uchun) ---------------------
# Standart 4096 MB juda katta — ochiq servisda diskni to'ldirish oson.
MG_MAX_UPLOAD_MB=512
MG_MAX_FILES=20000

# --- Server ------------------------------------------------
MG_HOST=127.0.0.1
MG_PORT=8077
MG_DATA_DIR=./data

# /docs va /openapi.json (standart: o'chiq)
# MG_ENABLE_DOCS=0
